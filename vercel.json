{
  "functions": {
    "api/projects/index.ts": {
      "runtime": "edge"
    },
    "api/equipment/index.ts": {
      "runtime": "edge"
    },
    "api/categories/index.ts": {
      "runtime": "edge"
    }
  },
  "regions": ["iad1", "fra1", "sin1"],
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}